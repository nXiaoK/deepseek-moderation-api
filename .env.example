# Generate real random values with: go run ./cmd/setup
MASTER_KEY=
ADMIN_USER=admin
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://audit@127.0.0.1:55439/audit?sslmode=disable
PUBLIC_URL=http://localhost:8090
LISTEN_ADDR=127.0.0.1:8090
STATIC_DIR=frontend/dist
# Explicitly trusted sub2api origins for Grok connections (no /v1 suffix).
# Empty keeps Grok connections disabled. Separate multiple origins with commas.
AUDIT_SUB2API_ORIGINS=
