{
  "name": "deepseek-audit-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:ui": "playwright test",
    "format": "prettier --write src tests index.html vite.config.ts playwright.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src tests index.html vite.config.ts playwright.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@lucide/vue": "1.45.0",
    "echarts": "6.1.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@vitejs/plugin-vue": "5.2.3",
    "prettier": "3.6.2",
    "typescript": "5.6.3",
    "vite": "6.4.1",
    "vue-tsc": "2.2.0"
  }
}
