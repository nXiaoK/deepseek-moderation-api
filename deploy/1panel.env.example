# Set these in the 1Panel Compose environment settings or a .env beside compose.yaml.
# Encode special characters in database credentials for use in a URI.
DATABASE_URL='postgres://audit:CHANGE_ME@db.example.com:5432/audit?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt'
# Generate on the server: openssl rand -base64 32
MASTER_KEY=
ADMIN_USER=admin
# Generate on the server: openssl rand -hex 24
ADMIN_PASSWORD=
PUBLIC_URL=https://audit.example.com
AUDIT_SUB2API_ORIGINS=
AUDIT_MODEL_CONCURRENCY=16
AUDIT_REQUEST_CONCURRENCY=32
AUDIT_REQUEST_BODY_MIB=128
AUDIT_TRIAL_CONCURRENCY=2
AUDIT_MAX_IMAGES=16
AUDIT_INGRESS_RPM=6000
AUDIT_INGRESS_IP_RPM=600
